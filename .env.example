# Copy to .env.local and fill in what you need. Every value is optional for a
# local UI run: without keys the dashboard uses the checked-in data/om-demo
# sample jobs and AI-backed routes fall back or return a clear error.

# --- Convex (app data, pipeline state) --------------------------------------
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Written by `npx convex dev`.
CONVEX_DEPLOYMENT=
# Dashboard reads come from data/om-demo unless both of these are set.
DASHBOARD_DATA_SOURCE=
DASHBOARD_LIVE_CONVEX_ENABLED=

# --- Auth (Better Auth + GitHub OAuth) --------------------------------------
BETTER_AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADDITIONAL_TRUSTED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local-only demo login shortcut.
DEMO_BYPASS_ENABLED=
NEXT_PUBLIC_DEMO_BYPASS_ENABLED=

# --- LLM providers -----------------------------------------------------------
# Either set AI_GATEWAY_API_KEY (Vercel AI Gateway) or the direct provider keys.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
K2THINK_API_KEY=
TAILOR_PROVIDER=
TAILOR_MODEL=
RESEARCH_PROVIDER=
RESEARCH_MODEL=
OPENAI_ASHBY_FILL_MODEL=
OPENAI_LEVER_FILL_MODEL=

# --- Profile intake ----------------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Encrypts the LinkedIn li_at cookie (AES-256-GCM). Generate: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=
PROXYCURL_API_KEY=
TAVILY_API_KEY=

# --- Application engine (Recruit2) ------------------------------------------
APPLY_ENGINE_API_URL=
MAX_APPLICATIONS_PER_RUN=
MAX_CONCURRENT_APPLICATIONS=
# Keep true unless you are deliberately testing a real ATS submit.
DEV_SKIP_REAL_SUBMIT=true

# --- Checkout ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_CHECKOUT_MOCK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Headless browser / PDF runtime ------------------------------------------
LOCAL_CHROME_PATH=
CHROMIUM_PACK_URL=
